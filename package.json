{
    "name": "wwsync",
    "displayName": "WWSync",
    "description": "Sync files with remote servers via rsync",
    "version": "1.3.0",
    "publisher": "batyan-soft",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Batyan45/wwsync-vscode"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onFileSystem:wwsync"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "WWSync",
            "properties": {
                "wwsync.showButtons": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show WWSync buttons in the editor title bar."
                },
                "wwsync.showStatusBar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show WWSync status bar item."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "wwsync",
                    "title": "WWSync",
                    "icon": "images/remote-files.svg"
                }
            ]
        },
        "views": {
            "wwsync": [
                {
                    "id": "wwsync.remoteFiles",
                    "name": "Remote Files",
                    "contextualTitle": "WWSync",
                    "icon": "images/remote-files.svg"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "wwsync.remoteFiles",
                "contents": "Shows the remote copy of this folder: the same server and folder that Safe Sync uses (see ~/.wwsync).\n[Open Remote Folder](command:wwsync.remoteExplorer.open)",
                "when": "!wwsync.remoteExplorer.active"
            }
        ],
        "commands": [
            {
                "command": "wwsync.safeSync",
                "title": "WWSync: Safe Sync",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "wwsync.fullSync",
                "title": "WWSync: Full Sync",
                "icon": "$(sync)"
            },
            {
                "command": "wwsync.run",
                "title": "WWSync: Run Remote Session",
                "icon": "$(terminal)"
            },
            {
                "command": "wwsync.downloadArtifacts",
                "title": "WWSync: Download Artifacts",
                "icon": "$(cloud-download)"
            },
            {
                "command": "wwsync.showMenu",
                "title": "WWSync: Show Menu"
            },
            {
                "command": "wwsync.remoteExplorer.open",
                "title": "Browse Remote Files",
                "category": "WWSync",
                "icon": "$(remote-explorer)"
            },
            {
                "command": "wwsync.remoteExplorer.switchServer",
                "title": "Switch Server...",
                "category": "WWSync",
                "icon": "$(server-environment)"
            },
            {
                "command": "wwsync.remoteExplorer.refresh",
                "title": "Refresh",
                "category": "WWSync",
                "icon": "$(refresh)"
            },
            {
                "command": "wwsync.remoteExplorer.newFile",
                "title": "New File...",
                "category": "WWSync",
                "icon": "$(new-file)"
            },
            {
                "command": "wwsync.remoteExplorer.newFolder",
                "title": "New Folder...",
                "category": "WWSync",
                "icon": "$(new-folder)"
            },
            {
                "command": "wwsync.remoteExplorer.goUp",
                "title": "Go to Parent Folder",
                "category": "WWSync",
                "icon": "$(arrow-up)"
            },
            {
                "command": "wwsync.remoteExplorer.goToProjectFolder",
                "title": "Go to Project Folder",
                "category": "WWSync",
                "icon": "$(home)"
            },
            {
                "command": "wwsync.remoteExplorer.setRoot",
                "title": "Go to This Folder",
                "category": "WWSync"
            },
            {
                "command": "wwsync.remoteExplorer.openToSide",
                "title": "Open to the Side",
                "category": "WWSync"
            },
            {
                "command": "wwsync.remoteExplorer.compareWithLocal",
                "title": "Compare with Local",
                "category": "WWSync",
                "icon": "$(diff)"
            },
            {
                "command": "wwsync.remoteExplorer.rename",
                "title": "Rename...",
                "category": "WWSync"
            },
            {
                "command": "wwsync.remoteExplorer.delete",
                "title": "Delete",
                "category": "WWSync"
            },
            {
                "command": "wwsync.remoteExplorer.copyPath",
                "title": "Copy Path",
                "category": "WWSync"
            },
            {
                "command": "wwsync.remoteExplorer.copyRelativePath",
                "title": "Copy Relative Path",
                "category": "WWSync"
            },
            {
                "command": "wwsync.remoteExplorer.openTerminal",
                "title": "Open in Remote Terminal",
                "category": "WWSync",
                "icon": "$(terminal)"
            },
            {
                "command": "wwsync.remoteExplorer.disconnect",
                "title": "Disconnect",
                "category": "WWSync",
                "icon": "$(debug-disconnect)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "wwsync.safeSync",
                    "group": "navigation@1",
                    "when": "config.wwsync.showButtons"
                },
                {
                    "command": "wwsync.fullSync",
                    "group": "navigation@2",
                    "when": "config.wwsync.showButtons"
                },
                {
                    "command": "wwsync.run",
                    "group": "navigation@3",
                    "when": "config.wwsync.showButtons"
                },
                {
                    "command": "wwsync.downloadArtifacts",
                    "group": "navigation@4",
                    "when": "config.wwsync.showButtons"
                }
            ],
            "editor/title/context": [
                {
                    "command": "wwsync.remoteExplorer.compareWithLocal",
                    "group": "3_compare@1",
                    "when": "resourceScheme == wwsync"
                }
            ],
            "view/title": [
                {
                    "command": "wwsync.remoteExplorer.newFile",
                    "group": "navigation@1",
                    "when": "view == wwsync.remoteFiles && wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.newFolder",
                    "group": "navigation@2",
                    "when": "view == wwsync.remoteFiles && wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.goUp",
                    "group": "navigation@3",
                    "when": "view == wwsync.remoteFiles && wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.goToProjectFolder",
                    "group": "navigation@4",
                    "when": "view == wwsync.remoteFiles && wwsync.remoteExplorer.outsideProject"
                },
                {
                    "command": "wwsync.remoteExplorer.refresh",
                    "group": "navigation@5",
                    "when": "view == wwsync.remoteFiles && wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.switchServer",
                    "group": "1_location@1",
                    "when": "view == wwsync.remoteFiles"
                },
                {
                    "command": "wwsync.remoteExplorer.openTerminal",
                    "group": "2_session@1",
                    "when": "view == wwsync.remoteFiles && wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.disconnect",
                    "group": "2_session@2",
                    "when": "view == wwsync.remoteFiles && wwsync.remoteExplorer.active"
                }
            ],
            "view/item/context": [
                {
                    "command": "wwsync.remoteExplorer.newFile",
                    "group": "navigation@1",
                    "when": "view == wwsync.remoteFiles && viewItem == remoteFolder"
                },
                {
                    "command": "wwsync.remoteExplorer.newFolder",
                    "group": "navigation@2",
                    "when": "view == wwsync.remoteFiles && viewItem == remoteFolder"
                },
                {
                    "command": "wwsync.remoteExplorer.openToSide",
                    "group": "navigation@3",
                    "when": "view == wwsync.remoteFiles && viewItem =~ /^remoteFile/"
                },
                {
                    "command": "wwsync.remoteExplorer.openTerminal",
                    "group": "navigation@4",
                    "when": "view == wwsync.remoteFiles && viewItem == remoteFolder"
                },
                {
                    "command": "wwsync.remoteExplorer.setRoot",
                    "group": "2_location@1",
                    "when": "view == wwsync.remoteFiles && viewItem == remoteFolder"
                },
                {
                    "command": "wwsync.remoteExplorer.refresh",
                    "group": "2_location@2",
                    "when": "view == wwsync.remoteFiles && viewItem == remoteFolder"
                },
                {
                    "command": "wwsync.remoteExplorer.compareWithLocal",
                    "group": "3_compare@1",
                    "when": "view == wwsync.remoteFiles && viewItem == remoteFile.mapped"
                },
                {
                    "command": "wwsync.remoteExplorer.copyPath",
                    "group": "6_copypath@1",
                    "when": "view == wwsync.remoteFiles"
                },
                {
                    "command": "wwsync.remoteExplorer.copyRelativePath",
                    "group": "6_copypath@2",
                    "when": "view == wwsync.remoteFiles"
                },
                {
                    "command": "wwsync.remoteExplorer.rename",
                    "group": "7_modification@1",
                    "when": "view == wwsync.remoteFiles"
                },
                {
                    "command": "wwsync.remoteExplorer.delete",
                    "group": "7_modification@2",
                    "when": "view == wwsync.remoteFiles"
                }
            ],
            "commandPalette": [
                {
                    "command": "wwsync.remoteExplorer.refresh",
                    "when": "wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.newFile",
                    "when": "wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.newFolder",
                    "when": "wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.goUp",
                    "when": "wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.goToProjectFolder",
                    "when": "wwsync.remoteExplorer.outsideProject"
                },
                {
                    "command": "wwsync.remoteExplorer.openTerminal",
                    "when": "wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.disconnect",
                    "when": "wwsync.remoteExplorer.active"
                },
                {
                    "command": "wwsync.remoteExplorer.compareWithLocal",
                    "when": "resourceScheme == wwsync"
                },
                {
                    "command": "wwsync.remoteExplorer.setRoot",
                    "when": "false"
                },
                {
                    "command": "wwsync.remoteExplorer.openToSide",
                    "when": "false"
                },
                {
                    "command": "wwsync.remoteExplorer.rename",
                    "when": "false"
                },
                {
                    "command": "wwsync.remoteExplorer.delete",
                    "when": "false"
                },
                {
                    "command": "wwsync.remoteExplorer.copyPath",
                    "when": "false"
                },
                {
                    "command": "wwsync.remoteExplorer.copyRelativePath",
                    "when": "false"
                }
            ]
        },
        "keybindings": [
            {
                "command": "wwsync.remoteExplorer.rename",
                "key": "f2",
                "when": "focusedView == wwsync.remoteFiles && !inputFocus"
            },
            {
                "command": "wwsync.remoteExplorer.delete",
                "key": "delete",
                "mac": "cmd+backspace",
                "when": "focusedView == wwsync.remoteFiles && !inputFocus"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "test": "npm run compile && node --test test/*.test.js",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "build-vsix": "vsce package",
        "version": "npm version --no-git-tag-version"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.74.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "typescript": "^5.0.0"
    }
}
